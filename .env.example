# MAVLink Drone Connection Configuration Template
# Copy this file to .env and fill in your actual drone connection details

# Drone connection details
MAVLINK_ADDRESS=your.drone.ip.address
MAVLINK_PORT=14540

# Protocol: tcp, udp, or serial
# Use tcp for network connections (most common for remote drones)
# Use udp for local simulators (default)
MAVLINK_PROTOCOL=tcp
# MCP HTTP Server Configuration
# Default: loopback only, for clients running on this same machine.
# To reach the server from another device, bind to this host's Tailscale
# address instead (e.g. MCP_HOST=100.x.x.x) on a host with zero public
# ports (ufw default-deny). Never set MCP_HOST=0.0.0.0 on a
# publicly-routable interface.
MCP_HOST=127.0.0.1      # Loopback only; use a tailnet address for remote clients
MCP_PORT=8080           # HTTP port for MCP server
